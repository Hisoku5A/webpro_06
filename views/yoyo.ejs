<!Doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title>ヨーヨーメンテナンス</title>
</head>
<body>
  <h2>ヨーヨーの詳細</h2>
  <table>
    <tr><th>スタイル</th><th>名前</th><th>色</th><th>前回の日付</th></tr>
      <% let number = 0 %>
      <% for( let row of data ) { %>
        <tr><td><%= row.style %></td>
        <td><a href="/yoyo/<%= number %>"><%= row.name %></a></ td>
        <td><%= row.color %></td>
        <td><%= row.data %></td>
        </tr>
        <% number += 1 %>
      <% } %>
  </table>
  <a href="yoyo_add.html">追加する</a>
</body>
</html>