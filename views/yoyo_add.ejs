<!Doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title>ヨーヨー追加</title>
</head>
<body>
    <h2>ヨーヨーの詳細</h2>

    <form action="/yoyo_add">
        <label for="id">ID</label>
        <input type="number" name="id" id="id" required>

        <label for="code">Code</label>
        <input type="text" name="code" id="code" required>

        
    </form>

    <table>
        <tr><th>コード</th><th>名前</th><th>色</th><th>前回の日付</th></tr>
        <% let number = 0 %>
        <% for( let row of data ) { %>
            <tr><td><%= row.code %></td>
                <td><a href="/yoyo/<%= number %>"><%= row.name %></a></ td>
                <td><%= row.color %></td>
                <td><%= row.data %></td>
            </tr>
        <% number += 1 %>
        <% } %>
    </table>
</body>
</html>